{
  "name": "multi-framework-test-generator",
  "version": "1.0.0",
  "description": "Framework-agnostic test generator for Cypress, Playwright, and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate": "npm run build && npm start",
    "lint": "tsc --noEmit"
  },
  "keywords": ["test", "generator", "cypress", "playwright", "automation"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.5",
    "jest": "^29.5.0",
    "prettier": "^2.8.6",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {}
}
